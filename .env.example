# Copy to `.env` and fill in. NEVER commit `.env` (NFR-19).

# --- App ---
DOCSTORE_ENV=development
LOG_LEVEL=INFO
LOG_RENDERER=console
API_PORT=8000
MCP_PORT=8100

# --- Security (REST + MCP Bearer tokens, comma-separated) ---
DOCSTORE_API_TOKENS=change-me-please

# --- OpenSearch ---
OPENSEARCH_USERNAME=admin
# Must satisfy OpenSearch's strong-password policy.
OPENSEARCH_PASSWORD=Str0ng!OpenSearch#Pass

# --- MinIO ---
MINIO_ACCESS_KEY=docstore
MINIO_SECRET_KEY=change-me-minio-secret

# --- LLM / Embeddings provider selection: ollama | openai | azure ---
LLM_PROVIDER=ollama
EMBEDDINGS_PROVIDER=ollama

# Ollama (default)
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# OpenAI (only if LLM_PROVIDER/EMBEDDINGS_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_LLM_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# Azure OpenAI (only if provider=azure)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_LLM_DEPLOYMENT=
# AZURE_OPENAI_EMBED_DEPLOYMENT=
