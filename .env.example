# Copy to `.env` and fill in. NEVER commit `.env` (NFR-19).

# --- App ---
# Unique name for this store instance. Used as prefix for OpenSearch indexes,
# MinIO bucket, and MCP server identity. Allows multiple independent stores to
# share the same database cluster. Defaults to "saga".
SAGA_STORE_NAME=saga
SAGA_ENV=development
# Store description — injected into LLM prompts to guide folder names, doc-type labels,
# and generated descriptions toward the archive's actual purpose.
#
# PREFERRED: edit  config/store-description.md  — supports multi-line Markdown and is
# version-control friendly.  The file is loaded automatically when this env var is empty.
#
# ALTERNATIVE 1: point to any file (useful for Docker secrets / mounted volumes):
# SAGA_STORE_DESCRIPTION_FILE=/run/secrets/store-description
#
# ALTERNATIVE 2: set inline here (single-line, escape newlines with \):
# SAGA_STORE_DESCRIPTION="This is the personal archive of the Miller family. ..."
#
# Priority: SAGA_STORE_DESCRIPTION > SAGA_STORE_DESCRIPTION_FILE > config/store-description.md
SAGA_STORE_DESCRIPTION=
# SAGA_STORE_DESCRIPTION_FILE=
LOG_LEVEL=INFO
LOG_RENDERER=console
API_PORT=8000
MCP_PORT=8100
# Language for LLM-generated content (summaries, folder names/descriptions, doc-type descriptions).
# Use a full English name understood by your LLM model: "German", "French", "Spanish", etc.
# Metadata extraction keys are always in English regardless of this setting.
SAGA_LANGUAGE=English

# --- Security (REST + MCP Bearer tokens, comma-separated) ---
SAGA_API_TOKENS=change-me-please

# --- CORS (browser UIs) ---
# Comma-separated allowed origins; '*' allows all. Restrict in production.
API_CORS_ALLOW_ORIGINS=*
API_CORS_ALLOW_CREDENTIALS=true

# --- OpenSearch ---
OPENSEARCH_USERNAME=admin
# Must satisfy OpenSearch's strong-password policy.
OPENSEARCH_PASSWORD=Str0ng!OpenSearch#Pass

# --- Postgres (relational system of record) ---
POSTGRES_USER=saga
POSTGRES_PASSWORD=change-me-postgres-secret
POSTGRES_DB=saga
# Full async DSN used by the app (overrides the assembled default if set).
POSTGRES_DSN=postgresql+asyncpg://saga:change-me-postgres-secret@postgres:5432/saga

# --- MinIO ---
MINIO_ACCESS_KEY=saga
MINIO_SECRET_KEY=change-me-minio-secret

# --- LLM / Embeddings provider selection: ollama | openai | azure ---
LLM_PROVIDER=ollama
EMBEDDINGS_PROVIDER=ollama

# Ollama base URL (used by LLM, embeddings and Docling VLM pipeline).
# In the standalone docker-compose this is set to http://ollama:11434 automatically.
# Override to point at an external Ollama instance.
# NOTE: this stays a SINGLE url; for multiple servers use the slots below.
OLLAMA_URL=http://ollama:11434

# --- Multiple Ollama servers (optional) -----------------------------------------
# Fill the slots to distribute LLM/embedding calls across several machines
# (e.g. gaming PCs with a GPU). Requests go to the least-busy healthy server;
# a switched-off machine is skipped automatically and picked up again when it
# returns. OLLAMA_MAX_CONCURRENT_n caps the parallel requests per server
# (empty = unlimited) — set it to 1 for weak machines so they are never swamped.
# OLLAMA_URL_1=http://ollama:11434
# OLLAMA_URL_2=http://gaming-pc:11434
# OLLAMA_MAX_CONCURRENT_2=2
# OLLAMA_URL_3=
# OLLAMA_URL_4=
# Failover/health tuning (defaults shown):
# OLLAMA_CONNECT_TIMEOUT=5.0       # seconds before an unreachable server is skipped
# OLLAMA_COOLDOWN_SECONDS=30       # seconds a failed server is left out
# OLLAMA_STARTUP_MODEL_CHECK=true  # verify required models on every server at startup
# OLLAMA_PULL_MISSING_MODELS=true  # worker pulls missing models (blocking) at startup

# Ollama models (default)
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Docling VLM pipeline -------------------------------------------------------
#
# Controls how docling-serve converts PDF pages using a vision-language model.
# Three modes are available - switch by setting DOCLING_VLM_MODE.
#
# mode: api (default) - external OpenAI-compatible endpoint
# Sends page images to an Ollama / vLLM / LM Studio endpoint.
# Requires the model to be pulled on the remote server first, e.g.:
#   ollama pull qwen2.5vl:7b          # markdown output, fast on GPU (recommended)
#   ollama pull granite-vision:3.2-2b # markdown output, smaller model
#
DOCLING_VLM_MODE=api
DOCLING_VLM_MODEL=qwen2.5vl:7b
# DOCLING_VLM_RESPONSE_FORMAT=markdown   # markdown (default) or doctags
#
# mode: preset - built-in docling-serve preset (no Ollama required)
# The model runs INSIDE the docling-serve container.
# Downloaded automatically from HuggingFace on first request.
# Mount a hf-cache volume in docker-compose.yml to persist downloads.
#
# Available presets (docling 2.91+):
#   granite_docling   ibm-granite/granite-docling-258M  DocTags   ~260 MB RAM
#   smoldocling       docling-project/SmolDocling-256M  DocTags   ~260 MB RAM
#   granite_vision    ibm-granite/granite-vision-3.2-2b Markdown  ~2 GB RAM
#
# To switch to preset mode, uncomment:
# DOCLING_VLM_MODE=preset
# DOCLING_VLM_PRESET=granite_docling
#
# mode: local - HuggingFace inline model (CPU via Transformers)
# To switch to local mode, uncomment:
# DOCLING_VLM_MODE=local
# DOCLING_VLM_REPO_ID=ibm-granite/granite-docling-258M
# DOCLING_VLM_RESPONSE_FORMAT=doctags   # doctags for granite-docling / SmolDocling
#
# Notes:
# - response_format must match the model:
#     generic vision models (qwen2.5vl, granite-vision) -> markdown
#     IBM granite-docling / SmolDocling                 -> doctags
# - granite-docling GGUF via Ollama (mode=api, model=ibm/granite-docling) is NOT
#   recommended: stops after ~188 tokens. Use mode=preset or mode=local instead.
# -------------------------------------------------------------------------------

# OpenAI (only if LLM_PROVIDER/EMBEDDINGS_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_LLM_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# Azure OpenAI (only if provider=azure)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_LLM_DEPLOYMENT=
# AZURE_OPENAI_EMBED_DEPLOYMENT=

# --- Per-step model overrides (optional) ---
# Each step can use a different model on the same provider/endpoint.
# Leave a variable unset or empty to inherit the global provider model.
# Useful for routing lightweight steps to a fast model and complex steps to a large one.
#
# Doc-type classification (classify_doc_type)
# LLM_DOC_TYPE_MODEL=
# LLM_DOC_TYPE_FALLBACK_MODEL=
#
# Value extraction (extract_values)
# LLM_VALUE_EXTRACTION_MODEL=
# LLM_VALUE_EXTRACTION_FALLBACK_MODEL=
#
# Summarisation (summarize)
# LLM_SUMMARY_MODEL=
# LLM_SUMMARY_FALLBACK_MODEL=
#
# Folder placement (place_in_folder)
# LLM_FOLDER_PLACEMENT_MODEL=
# LLM_FOLDER_PLACEMENT_FALLBACK_MODEL=

# --- Metrics (Prometheus) ---
# Enable/disable the /metrics endpoint and worker metrics HTTP server.
# METRICS_ENABLED=true
#
# Port for the worker process's Prometheus HTTP server (metrics.worker_port in config.yaml).
# Prometheus scrapes the worker at http://worker:<METRICS_WORKER_PORT>/metrics on the
# internal Docker network — no host port mapping is required.
# METRICS_WORKER_PORT=9000

# --- Langfuse (optional LLM observability) ---
# Leave empty to disable. Keys from Langfuse UI → Settings → API Keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud (default): https://cloud.langfuse.com
# US cloud: https://us.cloud.langfuse.com
# Self-hosted: http://your-host:3000
LANGFUSE_HOST=https://cloud.langfuse.com
